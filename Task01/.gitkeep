Task 1 - Class Design Review
#include <iostream>
#include <memory>
#include <string>
#include <vector>
using namespace std;

class Staff {
protected:
    string name;
    int id;

public:
    Staff(string n, int i) : name(n), id(i) {}

    virtual double pay() const = 0;

    virtual void display() const {
        cout << name << " (" << id << "): ";
    }

    virtual ~Staff() = default;
};

class Professor : public Staff {
    double basic, research;

public:
    Professor(string n, int i, double b, double r)
        : Staff(n, i), basic(b), research(r) {}

    double pay() const override {
        return basic + basic * 0.42 + research;
    }
};

class LabAssistant : public Staff {
    double basic;

public:
    LabAssistant(string n, int i, double b)
        : Staff(n, i), basic(b) {}

    double pay() const override {
        return basic + basic * 0.42;
    }
};

class GuestFaculty : public Staff {
    double hours, rate;

public:
    GuestFaculty(string n, int i, double h, double r)
        : Staff(n, i), hours(h), rate(r) {}

    double pay() const override {
        return hours * rate;
    }
};

int main() {
    vector<unique_ptr<Staff>> staff;

    staff.push_back(make_unique<Professor>(
        "Arun", 101, 50000, 10000));

    staff.push_back(make_unique<LabAssistant>(
        "Kavi", 102, 30000));

    staff.push_back(make_unique<GuestFaculty>(
        "Ravi", 103, 40, 1000));

    for (const auto& s : staff) {
        s->display();
        cout << s->pay() << '\n';
    }

    return 0;
}